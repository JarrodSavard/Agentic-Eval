{
  "name": "observatory-agent-reliability",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck",
    "contracts": "node scripts/contracts.mjs",
    "check:contracts": "node scripts/contracts.mjs --check",
    "check:budget": "node scripts/check-budget.mjs",
    "format": "prettier --write app tests scripts *.ts *.json *.md docs .github",
    "format:check": "prettier --check app tests scripts *.ts *.json *.md docs .github"
  },
  "dependencies": {
    "nuxt": "^4.4.2",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.0",
    "@playwright/test": "^1.58.0",
    "@vue/test-utils": "^2.4.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "happy-dom": "^20.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.2.0"
  }
}
